# Application
PORT=5000

# MySQL container
DB_HOST=mysql
DB_PORT=3306
DB_USER=fileforge_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=fileforge
MYSQL_ROOT_PASSWORD=CHANGE_THIS_DIFFERENT_STRONG_PASSWORD

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# false for HTTP. Change to true after HTTPS is configured.
COOKIE_SECURE=false
